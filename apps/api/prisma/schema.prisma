generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  authUserId     String       @unique @map("auth_user_id") @db.Uuid
  email          String       @unique
  displayName    String?      @map("display_name")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  ownedDataRooms DataRoom[]
  receivedGrants ShareGrant[]

  @@map("users")
}

model DataRoom {
  id             String   @id @default(uuid()) @db.Uuid
  ownerId        String   @map("owner_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folders     Folder[]
  files       FileRecord[]
  shareGrants ShareGrant[]
  publicLinks PublicLink[]

  @@unique([ownerId, normalizedName])
  @@map("data_rooms")
}

model Folder {
  id             String   @id @default(uuid()) @db.Uuid
  dataRoomId     String   @map("data_room_id") @db.Uuid
  parentId       String?  @map("parent_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  dataRoom    DataRoom     @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parent      Folder?      @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[]     @relation("FolderHierarchy")
  files       FileRecord[]
  shareGrants ShareGrant[]
  publicLinks PublicLink[]

  @@unique([dataRoomId, parentId, normalizedName])
  @@index([dataRoomId, parentId])
  @@index([parentId])
  @@map("folders")
}

model FileRecord {
  id             String       @id @default(uuid()) @db.Uuid
  dataRoomId     String       @map("data_room_id") @db.Uuid
  folderId       String?      @map("folder_id") @db.Uuid
  name           String
  normalizedName String       @map("normalized_name")
  storageKey     String       @unique @map("storage_key")
  mimeType       String       @map("mime_type")
  sizeBytes      BigInt       @map("size_bytes")
  checksum       String?
  uploadStatus   UploadStatus @default(PENDING) @map("upload_status")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  dataRoom    DataRoom     @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  shareGrants ShareGrant[]
  publicLinks PublicLink[]

  @@unique([dataRoomId, folderId, normalizedName])
  @@index([folderId, createdAt, id])
  @@index([dataRoomId, folderId])
  @@map("files")
}

model ShareGrant {
  id              String    @id @default(uuid()) @db.Uuid
  dataRoomId      String?   @map("data_room_id") @db.Uuid
  folderId        String?   @map("folder_id") @db.Uuid
  fileId          String?   @map("file_id") @db.Uuid
  recipientUserId String?   @map("recipient_user_id") @db.Uuid
  recipientEmail  String    @map("recipient_email")
  role            ShareRole @default(VIEWER)
  notifiedAt      DateTime? @map("notified_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  dataRoom      DataRoom?   @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder        Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  file          FileRecord? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  recipientUser User?       @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, revokedAt])
  @@index([recipientEmail, revokedAt])
  @@index([dataRoomId])
  @@index([folderId])
  @@index([fileId])
  @@map("share_grants")
}

model PublicLink {
  id         String    @id @default(uuid()) @db.Uuid
  dataRoomId String?   @map("data_room_id") @db.Uuid
  folderId   String?   @map("folder_id") @db.Uuid
  fileId     String?   @map("file_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  dataRoom DataRoom?   @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder   Folder?     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  file     FileRecord? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([dataRoomId])
  @@index([folderId])
  @@index([fileId])
  @@map("public_links")
}

enum UploadStatus {
  PENDING
  READY
  FAILED
  DELETING
}

enum ShareRole {
  VIEWER
}
