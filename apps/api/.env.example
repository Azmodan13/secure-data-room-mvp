NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# Transaction pooler for application runtime.
DATABASE_URL="postgresql://postgres.your-project-ref:password@your-pooler-host:6543/postgres?pgbouncer=true"

# Session pooler for Prisma migrations on IPv4 networks.
DIRECT_URL="postgresql://postgres.your-project-ref:password@your-pooler-host:5432/postgres"

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_STORAGE_BUCKET=data-room-files
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

SUPABASE_JWT_AUDIENCE=authenticated
